@bot.event
async def on_ready():
    print(f'We have logged in as {bot.user}')

@bot.command()
async def info(ctx):
    await ctx.send(f'Hola, soy {bot.user}, estoy especializado en dar estrategias para el cuidado de ecosistemas planetarios que contienen vida. Puedo dar consejos sobre cómo mantener un ecosistema saludable y sostenible. ¡Pregúntame cualquier cosa relacionada con el cuidado del medio ambiente!')

@bot.command()
async def consejo(ctx, estrategia: str):
    if estrategia in consejos:
        await ctx.send(consejos[estrategia])
    else:
        await ctx.send("No existe esta estrategia.")

@bot.command()
async def listaconsejos(ctx):
    lista = "\n".join(consejos.keys())
    await ctx.send(f"Lista de estrategias disponibles:\n{lista}")

@bot.command()
async def ramas(ctx):
